# Komorebi Affiliate Tracker — environment template.
# Copy to .env and fill in. Never commit the real .env.
#
# Legend:  [REQUIRED in prod]  must be set for production.
#          [OPTIONAL]          safe default if unset (behavior noted).

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# [OPTIONAL] HTTP port the app listens on. Default: 3000.
PORT=3000

# [OPTIONAL] 'production' enables Secure cookies + the production guards below.
# Anything else = development. Default: development.
NODE_ENV=production

# [REQUIRED in prod] Public base URL (https domain). Used for tracking links,
# smart links (/go/:pub), password-reset email links, and marketplace.
# If unset it falls back to http://localhost:PORT and those URLs will be wrong.
BASE_URL=https://track.komorebimedia.com

# ---------------------------------------------------------------------------
# Admin auth & sessions
# ---------------------------------------------------------------------------

# [OPTIONAL] Admin username. Default: admin.
ADMIN_USER=admin

# [REQUIRED in prod] Admin password. If unset in production the app EXITS on
# startup (FATAL). In development an unset value disables admin login.
ADMIN_PASS=change-me

# [REQUIRED in prod] Session signing secret. If unset, an insecure built-in
# default is used and a startup warning (console + Telegram) is emitted.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-random-hex-string

# [OPTIONAL] Idle-timeout override IN SECONDS for BOTH admin and publisher
# sessions (mainly for tests). If unset, both idle out after 5 minutes.
# ADMIN_IDLE_SECONDS=300

# ---------------------------------------------------------------------------
# Notifications (email + webhooks)
# ---------------------------------------------------------------------------

# [OPTIONAL] Recipient for admin emails (new conversions, daily summary, new
# publisher applications). Default: chi@komorebimedia.com.
ADMIN_EMAIL=chi@komorebimedia.com

# [OPTIONAL] Gmail SMTP credentials. If BOTH unset, all email is disabled
# (password-reset tokens then surface on the admin publisher-edit page instead).
# Use a Gmail App Password — https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_PASS=

# [OPTIONAL] Telegram alerts (conversions, daily summary, advertiser-cap 80/100%,
# MMP sync summaries, startup security warnings). If unset, Telegram is skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# [OPTIONAL] Slack incoming webhook for the same notifications. Unset = skipped.
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Postback security & rate limiting
# ---------------------------------------------------------------------------

# [OPTIONAL] IP whitelist for /postback/*. Default behavior = ENABLED.
# Set to 'false' ONLY for local testing (allows postbacks from any IP).
POSTBACK_WHITELIST_ENABLED=true

# [OPTIONAL] Extra trusted postback IPs (comma-separated), added to the built-in
# AppsFlyer/Adjust lists. Unset = just the built-in lists.
POSTBACK_TRUSTED_IPS=

# [OPTIONAL] Global rate limit, requests/min per IP (all routes except /postback).
# Default: 100.
RATE_LIMIT_MAX=100

# [OPTIONAL] Dedicated rate limit for /postback/*, requests/min per IP (separate
# from the global limit — MMP servers send bursts). Default: 300.
POSTBACK_RATE_LIMIT_MAX=300

# ---------------------------------------------------------------------------
# MMP integration (AppsFlyer) — F20
# ---------------------------------------------------------------------------

# [REQUIRED if using MMP] 32-byte key as 64 hex chars (any other string is
# SHA-256-derived to 32 bytes). Encrypts advertiser MMP API tokens at rest
# (AES-256-GCM). If UNSET, tokens are stored in PLAINTEXT and a startup warning
# is logged. KEEP THIS STABLE AND BACKED UP — losing/changing it makes existing
# encrypted tokens undecryptable (they must be re-entered).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MMP_ENCRYPTION_KEY=

# [OPTIONAL] AppsFlyer API base URL. Default: https://hq1.appsflyer.com.
# Override only for staging or a mock server.
MMP_APPSFLYER_BASE=https://hq1.appsflyer.com
