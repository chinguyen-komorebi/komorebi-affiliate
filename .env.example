PORT=3000
BASE_URL=https://your-domain.com
ADMIN_USER=admin
ADMIN_PASS=changeme

# Email (Gmail SMTP)
ADMIN_EMAIL=chi@komorebimedia.com
GMAIL_USER=your-gmail@gmail.com
# Use a Gmail App Password — https://myaccount.google.com/apppasswords
GMAIL_PASS=your-app-password

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-random-hex-string

# AppsFlyer / Adjust postback whitelist (set to false for testing)
POSTBACK_WHITELIST_ENABLED=true
# Comma-separated extra IPs to trust (your own server, staging, etc.)
POSTBACK_TRUSTED_IPS=
